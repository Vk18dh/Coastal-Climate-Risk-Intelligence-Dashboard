# Application Configuration
PROJECT_NAME="Coastal Climate Risk Intelligence Platform"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# PostgreSQL / PostGIS Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coastal_risk_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coastal_risk_db

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRE_SECONDS=900

# 100% Free AI / LLM Configuration (Groq & Local Embeddings)
AI_PROVIDER="groq"
GROQ_API_KEY="your_free_groq_api_key_here"
AI_MODEL_NAME="llama-3.3-70b-versatile"
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
AI_TEMPERATURE=0.2

# 100% Free GIS & Map Tile Configuration (OpenFreeMap + Leaflet / OpenStreetMap)
MAP_ENGINE="leaflet"
MAP_TILE_PROVIDER="openfreemap"
MAP_TILE_URL="https://tiles.openfreemap.org/styles/bright"
MAP_ATTRIBUTION="&copy; <a href='https://openfreemap.org'>OpenFreeMap</a> &copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a>"

# 100% Free Weather & Marine Data APIs (Open-Meteo - No API Key Required)
WEATHER_API_PROVIDER="open-meteo"
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
MARINE_API_URL="https://marine-api.open-meteo.com/v1/marine"
