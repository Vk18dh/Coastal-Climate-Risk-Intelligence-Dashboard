# ─────────────────────────────────────────────────────────────────────────────
# Coastal Climate Risk Intelligence Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Coastal Climate Risk Intelligence Dashboard
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Force UTF-8 stdout/stderr on Windows to prevent UnicodeEncodeError in logs
PYTHONUTF8=1

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://coastal_user:coastal_pass@localhost:5432/coastal_climate_db

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External Data Sources (not used until Phase 4) ────────────────────────────
# IMD (India Meteorological Department) — restricted API, key required
IMD_API_KEY=

# INCOIS (Indian National Centre for Ocean Information Services)
INCOIS_API_KEY=

# Open-Meteo — free, no key required, used as weather fallback
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Frontend (Vite env vars must be prefixed with VITE_) ─────────────────────
# Leave empty during local dev — Vite proxy handles /api routing automatically
VITE_API_BASE_URL=
